# ---------------------------------------------------------------------------
# Invariants the checker cannot verify.
#
# Written down anyway: this is the list a reviewer -- or an agent -- checks by
# hand, and the reason it exists is that nothing else will catch these.
# ---------------------------------------------------------------------------

[invariants]
rules = [
  "Every write scoped to a tenant goes through a repository, never a raw session.execute.",
  "Money is stored in minor units as an integer. Never a float.",
  "A job handler is idempotent: delivery is at-least-once.",
  "TODO: replace these with the rules that actually matter here.",
]
