[# Scaffold-time values use square brackets; Vue keeps its own {{ }}. #]
<template>
  <LayoutAuthenticated>
    <SectionMain>
      <SectionTitleLineWithButton :icon="mdiViewDashboardOutline" title="[[ view_title ]]" main>
        <button class="rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"
          @click="fetchData">
          Refresh
        </button>
      </SectionTitleLineWithButton>

      <CardBox class="mb-6">
        <p v-if="loading" class="text-sm text-slate-500">Loading…</p>
        <p v-else-if="error" class="text-sm text-red-600">{{ error }}</p>
        <p v-else-if="!items.length" class="py-8 text-center text-sm text-slate-500">
          Nothing here yet.
        </p>
        <ul v-else class="divide-y divide-slate-200 dark:divide-slate-700">
          <li v-for="item in items" :key="item.id" class="py-3">
            <span class="font-medium">{{ item.name }}</span>
            <span v-if="item.description" class="ml-2 text-sm text-slate-500">
              {{ item.description }}
            </span>
          </li>
        </ul>
      </CardBox>
    </SectionMain>
  </LayoutAuthenticated>
</template>

<script setup>
import { mdiViewDashboardOutline } from '@mdi/js'
import { onMounted, ref } from 'vue'

import CardBox from '@/components/CardBox.vue'
import SectionMain from '@/components/SectionMain.vue'
import SectionTitleLineWithButton from '@/components/SectionTitleLineWithButton.vue'
import LayoutAuthenticated from '@/layouts/LayoutAuthenticated.vue'
import { list[[ View ]] } from '@/Modulo[[ View ]]/Services/[[ view_slug ]].service.js'

const items = ref([])
const loading = ref(false)
const error = ref(null)

// HTTP lives in the service, not here. The component owns loading and error
// state; the service owns the request.
const fetchData = async () => {
  loading.value = true
  error.value = null
  try {
    items.value = await list[[ View ]]()
  } catch (err) {
    error.value = err.message
  } finally {
    loading.value = false
  }
}

onMounted(fetchData)
</script>
