# {{ service_title }} configuration.
# Committed to git -- never put secrets here. Secrets come from the
# environment and are typed SecretStr, which keeps them out of
# `jfast describe` and the /info endpoint.

[app]
name = "{{ service_slug }}"
version = "0.1.0"
env = "local"
port = {{ port }}

[plugins]
enabled = [{% for name in enabled_plugins %}"{{ name }}"{{ ", " if not loop.last }}{% endfor %}]
disabled = []

[plugin.observability]
level = "INFO"
json_logs = false   # readable in a dev terminal; set true in deployed envs

{% if has_database %}
[plugin.database]
pool_size = 10
# DSN comes from JFAST_DB_DSN, not from here.
{% endif %}
{% if has_cache %}

[plugin.cache]
default_ttl = 300
{% endif %}
{% if has_mongo %}

[plugin.mongo]
database = "{{ service_slug }}"
{% endif %}
{% if has_qdrant %}

[plugin.qdrant]
# URL comes from JFAST_QDRANT_URL.
{% endif %}
{% if has_rag %}

[plugin.rag]
store = "{{ rag_store }}"
collection = "rag_chunks"
dimensions = 768        # must match the embedding model
ollama_model = "nomic-embed-text"
{% endif %}
{% if has_queue %}

[plugin.queue]
backend = "{{ queue_backend }}"   # postgres | redis | rabbitmq
name = "jfast_jobs"
max_attempts = 3
{% endif %}
{% if has_auth %}

[plugin.auth]
# jwks       : fetch public keys from an identity service. Right for more than
#              one service -- no shared secret to leak.
# public_key : a pinned PEM. Same trust model, no network dependency.
# secret     : HMAC. Simple, and every holder can also MINT tokens.
mode = "jwks"
algorithms = ["RS256"]
# jwks_url comes from JFAST_AUTH_JWKS_URL.
issuer = ""
audience = "{{ service_slug }}"   # without this, a token for any sibling service is accepted
{% endif %}
{% if has_events %}

[plugin.events]
bootstrap_servers = "localhost:{{ port + 2 }}"
consumer_group = "{{ service_slug }}"
{% endif %}
{% if has_web %}

[plugin.web]
templates_dir = "templates"
static_dir = "static"
auto_reload = true      # development only: stats the filesystem per render
{% endif %}

{% if has_storage %}

[plugin.storage]
default = "public"
serve_local = true      # development only: Caddy or a CDN serves these in prod
# signing_key comes from JFAST_STORAGE_SIGNING_KEY. Without it, private disks
# cannot produce a temporary URL and every download link fails.

[plugin.storage.disks.public]
driver = "local"
root = "storage/public"
visibility = "public"   # permanent URLs

[plugin.storage.disks.private]
driver = "local"
root = "storage/private"
visibility = "private"  # signed URLs that expire
{% endif %}
{% if has_tenancy %}

[plugin.tenancy]
# Ordered by trust: the first source that yields a tenant wins. "header" is
# absent on purpose -- X-Tenant-ID is one curl away from another tenant's data.
sources = [{% if has_auth %}"token", {% endif %}"subdomain"]
# Required, or every hostname looks like a tenant and the service refuses to
# start. acme.<base_domain> then resolves to the tenant "acme".
base_domain = "localhost"
require_tenant = false
{% endif %}
{% if has_notifications %}

[plugin.notifications]
# console logs instead of sending: no Firebase project needed in development.
backend = "console"     # console | fcm
project_id = ""
{% endif %}

# Not enabled. Add the name to [plugins].enabled and install its extra:
{% for name, extra in available_plugins %}
#   {{ "%-12s"|format(name) }} pip install "jfastframework[{{ extra }}]"
{% endfor %}
