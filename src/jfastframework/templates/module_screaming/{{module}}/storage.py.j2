"""Persistence for {{ module_title }}.

The SQLAlchemy model lives here, not in the domain. ``to_domain`` is the seam:
the domain never learns what a table is, and swapping the storage engine
touches only this file.
"""

from __future__ import annotations

from sqlalchemy.orm import Mapped, mapped_column

from jfastframework.db import Base, BaseRepository, TenantMixin, TimestampMixin

from .{{ module }} import {{ Module }}


class {{ Module }}Row(Base, TimestampMixin, TenantMixin):
    __tablename__ = "{{ table }}"

    id: Mapped[int] = mapped_column(primary_key=True)
    name: Mapped[str] = mapped_column(index=True)
    description: Mapped[str | None] = mapped_column(default=None)
    is_active: Mapped[bool] = mapped_column(default=True)

    def to_domain(self) -> {{ Module }}:
        return {{ Module }}(
            id=self.id,
            name=self.name,
            description=self.description,
            is_active=self.is_active,
            tenant_id=self.tenant_id,
            created_at=self.created_at,
            updated_at=self.updated_at,
        )


class {{ Module }}Repository(BaseRepository[{{ Module }}Row]):
    model = {{ Module }}Row

    async def by_name(self, name: str) -> {{ Module }}Row | None:
        return await self.find_one(name=name)
