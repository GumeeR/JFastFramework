import React from 'react'
import ReactDOM from 'react-dom/client'
import { RouterProvider } from 'react-router-dom'

import ToastHost from '@/components/ToastHost.jsx'
import router from '@/router'
import '@/style.css'

// ToastHost sits outside the router on purpose: a toast raised during a route
// transition has to survive it, and a host inside the routed tree unmounts
// mid-navigation taking the message with it. Exactly once, too -- a second
// host renders the same list twice rather than giving toasts a second home.
ReactDOM.createRoot(document.getElementById('root')).render(
  <React.StrictMode>
    <RouterProvider router={router} />
    <ToastHost />
  </React.StrictMode>,
)
