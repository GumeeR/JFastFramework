import BaseIcon from '@/components/BaseIcon.jsx'

// title and description are both required. "Nothing matches this filter" and
// "we could not load this" look identical when both are a blank panel, and the
// blank panel is the one the user reads as a broken screen.
export default function EmptyState({ title, description, icon = null, className = '', children }) {
  return (
    <div className={`flex flex-col items-center px-6 py-12 text-center ${className}`}>
      {icon ? (
        <BaseIcon path={icon} size="lg" className="mb-4 text-zinc-500 dark:text-zinc-400" />
      ) : null}
      <h3 className="text-base font-semibold text-zinc-900 dark:text-zinc-100">{title}</h3>
      <p className="mt-2 max-w-sm text-sm text-zinc-500 dark:text-zinc-400">{description}</p>
      {children ? <div className="mt-6">{children}</div> : null}
    </div>
  )
}
