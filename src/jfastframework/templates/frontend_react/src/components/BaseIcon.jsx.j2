const SIZES = { sm: 'h-4 w-4', md: 'h-5 w-5', lg: 'h-6 w-6' }

// Renders an @mdi/js path string. @mdi/js ships path data only -- no runtime,
// no icon font, and tree-shaken to the icons actually imported.
export default function BaseIcon({ path, size = 'md', className = '' }) {
  return (
    <span className={`inline-flex items-center justify-center ${SIZES[size] ?? SIZES.md} ${className}`}>
      <svg viewBox="0 0 24 24" className="h-full w-full" aria-hidden="true">
        <path d={path} fill="currentColor" />
      </svg>
    </span>
  )
}
