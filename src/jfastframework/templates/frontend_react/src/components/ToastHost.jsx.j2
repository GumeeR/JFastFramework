import { mdiAlertCircleOutline, mdiCheckCircleOutline, mdiClose, mdiInformationOutline } from '@mdi/js'

import BaseButton from '@/components/BaseButton.jsx'
import BaseIcon from '@/components/BaseIcon.jsx'
import useToast from '@/hooks/useToast.js'

// Each toast carries a word as well as a colour and an icon, because colour on
// its own says nothing to a screen reader and not much to a red-green eye.
const TYPES = {
  success: { word: 'Success', icon: mdiCheckCircleOutline, tint: 'text-emerald-600 dark:text-emerald-400' },
  error: { word: 'Error', icon: mdiAlertCircleOutline, tint: 'text-brand-600 dark:text-brand-500' },
  info: { word: 'Info', icon: mdiInformationOutline, tint: 'text-sky-600 dark:text-sky-400' },
}

// Mount this once, at the app root, next to the router. A live region has to
// be in the document before content lands in it -- a host mounted on demand
// alongside its first toast announces nothing.
export default function ToastHost() {
  const toasts = useToast((state) => state.toasts)
  const dismiss = useToast((state) => state.dismiss)

  return (
    <div
      role="region"
      aria-label="Notifications"
      // pointer-events-none on the stack, auto on each toast: an empty stack
      // sits over the bottom of the page and must not eat clicks there.
      className="pointer-events-none fixed inset-x-0 bottom-0 z-50 flex flex-col items-center gap-3 p-4 sm:items-end"
    >
      {toasts.map((toast) => {
        const { word, icon, tint } = TYPES[toast.type] ?? TYPES.info
        return (
          <div
            key={toast.id}
            role="status"
            className="pointer-events-auto flex w-full max-w-sm items-start gap-3 rounded-xl border border-line bg-panel p-4"
          >
            <BaseIcon path={icon} className={`mt-0.5 shrink-0 ${tint}`} />
            <div className="min-w-0 flex-1">
              <p className="text-sm font-medium text-ink">{word}</p>
              <p className="mt-1 text-sm break-words text-ink-soft">
                {toast.message}
              </p>
            </div>
            <BaseButton
              variant="ghost"
              size="sm"
              icon={mdiClose}
              aria-label={`Dismiss ${word.toLowerCase()} notification`}
              onClick={() => dismiss(toast.id)}
            />
          </div>
        )
      })}
    </div>
  )
}
