// Status hues come from Tailwind's default palette rather than @theme: they
// mean a state, not the brand, and a project that restyles the accent should
// not end up with a crimson "success".
const STATUSES = {
  neutral:
    'border-line bg-elevated text-ink-soft',
  success:
    'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-900 dark:bg-emerald-950 dark:text-emerald-300',
  warning:
    'border-amber-200 bg-amber-50 text-amber-800 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-300',
  info: 'border-sky-200 bg-sky-50 text-sky-700 dark:border-sky-900 dark:bg-sky-950 dark:text-sky-300',
  danger:
    'border-brand-100 bg-brand-50 text-brand-700 dark:border-brand-900 dark:bg-brand-900/40 dark:text-brand-100',
}

// The label falls back to the status name so the badge can never render as a
// bare coloured dot: colour alone is not a status for anyone who cannot tell
// these five apart, and it is nothing at all in a screen reader.
export default function BaseBadge({ status = 'neutral', className = '', children }) {
  return (
    <span
      className={`inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-medium ${
        STATUSES[status] ?? STATUSES.neutral
      } ${className}`}
    >
      {children ?? status}
    </span>
  )
}
