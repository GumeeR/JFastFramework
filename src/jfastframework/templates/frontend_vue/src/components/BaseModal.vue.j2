<template>
  <Teleport to="body">
    <Transition enter-active-class="transition-opacity duration-150" enter-from-class="opacity-0"
      leave-active-class="transition-opacity duration-150" leave-to-class="opacity-0">
      <div v-if="modelValue" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4 backdrop-blur-sm"
        @click.self="close">
        <div ref="panel" role="dialog" aria-modal="true" :aria-labelledby="titleId" tabindex="-1"
          class="w-full max-w-lg rounded-lg border border-zinc-200 bg-white p-6 text-zinc-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-100"
          @keydown.tab="trapTab">
          <div class="mb-4 flex items-start justify-between gap-4">
            <h2 :id="titleId" class="text-lg font-semibold">{{ title }}</h2>
            <button type="button" aria-label="Close dialog"
              class="rounded-md p-2 text-zinc-500 transition-colors duration-150 hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:text-zinc-400 dark:hover:bg-zinc-800"
              @click="close">
              <BaseIcon :path="mdiClose" size="sm" />
            </button>
          </div>

          <slot />

          <div v-if="$slots.footer" class="mt-6 flex justify-end gap-3">
            <slot name="footer" />
          </div>
        </div>
      </div>
    </Transition>
  </Teleport>
</template>

<script setup>
import { mdiClose } from '@mdi/js'
import { nextTick, onBeforeUnmount, ref, useId, watch } from 'vue'

import BaseIcon from '@/components/BaseIcon.vue'

// `title` is required because aria-labelledby points at it: a dialog with no
// accessible name is announced as "dialog" and nothing else.
const props = defineProps({
  modelValue: Boolean,
  title: { type: String, required: true },
})

const emit = defineEmits(['update:modelValue'])

const panel = ref(null)
const titleId = useId()
let previouslyFocused = null

const FOCUSABLE =
  'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'

const close = () => emit('update:modelValue', false)

const onKeydown = (event) => {
  if (event.key === 'Escape') {
    close()
  }
}

// Queried on every Tab rather than cached once on open: a dialog body that
// renders conditionally would otherwise cycle focus through elements that are
// no longer in the document.
const trapTab = (event) => {
  const items = panel.value?.querySelectorAll(FOCUSABLE)
  if (!items || items.length === 0) {
    return
  }

  const first = items[0]
  const last = items[items.length - 1]
  const active = document.activeElement

  if (event.shiftKey && (active === first || active === panel.value)) {
    event.preventDefault()
    last.focus()
  } else if (!event.shiftKey && active === last) {
    event.preventDefault()
    first.focus()
  }
}

const teardown = () => {
  document.removeEventListener('keydown', onKeydown)
  document.body.style.overflow = ''
}

watch(
  () => props.modelValue,
  async (open) => {
    if (open) {
      previouslyFocused = document.activeElement
      document.addEventListener('keydown', onKeydown)
      document.body.style.overflow = 'hidden'
      // The panel is not in the DOM until the Teleport has rendered.
      await nextTick()
      panel.value?.focus()
      return
    }

    teardown()
    // Focus returns to whatever opened the dialog. Without this the next Tab
    // starts from the top of the document, which to a keyboard user reads as
    // the page having reloaded under them.
    previouslyFocused?.focus?.()
    previouslyFocused = null
  },
  // Immediate, because a modal can be mounted already open -- a route that
  // renders one, or a v-if that flips in the same tick. Without this the open
  // branch never runs for that case: no focus trap, no Escape handler, and a
  // page behind it that still scrolls.
  { immediate: true },
)

// The dialog can be unmounted while still open -- a route change with the modal
// up does exactly that. Nothing else would remove the document listener or give
// the body its scrollbar back, and the next page would be silently unscrollable.
onBeforeUnmount(teardown)
</script>
