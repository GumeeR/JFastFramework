<template>
  <div class="flex min-h-full items-center justify-center bg-surface p-4 text-ink">
    <CardBox class="w-full max-w-sm">
      <h1 class="text-lg font-semibold">Sign in</h1>
      <p class="mt-1 mb-6 text-sm text-ink-faint">{{ appName }}</p>

      <form novalidate @submit.prevent="submit">
        <BaseInput v-model="email" label="Email" type="email" autocomplete="username" required
          class="mb-4" />
        <BaseInput v-model="password" label="Password" type="password"
          autocomplete="current-password" required class="mb-4" :error="error" />
        <BaseButton type="submit" class="w-full" :loading="pending">Sign in</BaseButton>
      </form>
    </CardBox>
  </div>
</template>

<script setup>
import { ref } from 'vue'
import { useRoute, useRouter } from 'vue-router'

import BaseButton from '@/components/BaseButton.vue'
import BaseInput from '@/components/BaseInput.vue'
import CardBox from '@/components/CardBox.vue'
import { useAuthStore } from '@/stores/auth.store.js'

const appName = import.meta.env.VITE_APP_NAME
const route = useRoute()
const router = useRouter()
const auth = useAuthStore()

const email = ref('')
const password = ref('')
const error = ref(null)
const pending = ref(false)

// The router guard and the 401 handler both arrive here with ?next, so signing
// in returns to the page that was asked for rather than dumping everyone on
// the home page.
//
// Only a path, never an absolute URL: `next` comes from the address bar, and
// following one that starts with a host is an open redirect.
function destination() {
  const next = route.query.next
  return typeof next === 'string' && next.startsWith('/') && !next.startsWith('//') ? next : '/'
}

async function submit() {
  error.value = null
  pending.value = true
  try {
    await auth.login({ email: email.value, password: password.value })
    // replace, not push: the back button must not return to a sign-in form
    // that is already satisfied.
    await router.replace(destination())
  } catch (failure) {
    error.value = failure.message
  } finally {
    pending.value = false
  }
}
</script>
