"""{{ module_title }} entities.

Plain dataclasses. No ORM, no Pydantic, no framework import of any kind: the
entity is the same object whether it arrived from PostgreSQL, from a JSON body
or from a test that made it up.

The split that matters: a rule about this object's own state lives here, and a
rule that has to ask storage a question lives in a use case. "The name may not
be empty" is here. "The name may not already be taken" is not -- answering it
needs the repository, and reaching for one from an entity is how the domain
grows a database dependency one method at a time.
"""

from __future__ import annotations

from collections.abc import Mapping
from dataclasses import dataclass
from datetime import datetime
from typing import Any, ClassVar

MAX_NAME_LENGTH = 200
MAX_DESCRIPTION_LENGTH = 2000


class {{ Module }}RuleViolation(Exception):
    """A {{ module }} was asked to enter a state its rules forbid.

    The domain's own exception rather than ``jfastframework.errors``: importing
    that package pulls in the app factory, and with it FastAPI. Use cases
    translate this into the framework error the HTTP layer knows how to render.
    """


@dataclass
class {{ Module }}:
    """The {{ module_title }} entity."""

    name: str
    description: str | None = None
    is_active: bool = True
    # Assigned by whatever stores the entity. None means "not stored yet",
    # which is why `add` and `save` are separate methods on the port.
    id: int | None = None
    tenant_id: str | None = None
    created_at: datetime | None = None
    updated_at: datetime | None = None

    #: Fields a partial update may touch. Anything outside this set is owned by
    #: storage, and letting a PATCH body reach it is how `tenant_id` gets
    #: rewritten by a caller who guessed a field name.
    MUTABLE_FIELDS: ClassVar[frozenset[str]] = frozenset({"name", "description", "is_active"})

    def __post_init__(self) -> None:
        self.validate()

    def validate(self) -> None:
        if not self.name or not self.name.strip():
            raise {{ Module }}RuleViolation("name must not be empty")
        if len(self.name) > MAX_NAME_LENGTH:
            raise {{ Module }}RuleViolation(f"name must be at most {MAX_NAME_LENGTH} characters")
        if self.description is not None and len(self.description) > MAX_DESCRIPTION_LENGTH:
            raise {{ Module }}RuleViolation(
                f"description must be at most {MAX_DESCRIPTION_LENGTH} characters"
            )

    def apply(self, changes: Mapping[str, Any]) -> None:
        """Merge a partial update and re-check every rule.

        Validating the merged entity rather than the patch is the point: each
        field can be individually acceptable and the result still invalid.
        """
        unknown = sorted(set(changes) - self.MUTABLE_FIELDS)
        if unknown:
            raise {{ Module }}RuleViolation(f"cannot update: {', '.join(unknown)}")
        for field_name, value in changes.items():
            setattr(self, field_name, value)
        self.validate()

    def rename(self, name: str) -> None:
        self.name = name
        self.validate()

    def deactivate(self) -> None:
        if not self.is_active:
            raise {{ Module }}RuleViolation("already inactive")
        self.is_active = False

    def activate(self) -> None:
        self.is_active = True
