[# Scaffold-time values use square brackets; JSX keeps its own braces. #]
import { mdiViewDashboardOutline } from '@mdi/js'
import { useCallback, useEffect, useState } from 'react'

import CardBox from '@/components/CardBox.jsx'
import SectionMain from '@/components/SectionMain.jsx'
import SectionTitleLineWithButton from '@/components/SectionTitleLineWithButton.jsx'
import LayoutAuthenticated from '@/layouts/LayoutAuthenticated.jsx'
import { list[[ View ]] } from '@/Modulo[[ View ]]/Services/[[ view_slug ]].service.js'

export default function [[ View ]]View() {
  const [items, setItems] = useState([])
  const [loading, setLoading] = useState(false)
  const [error, setError] = useState(null)

  // HTTP lives in the service, not here. The component owns loading and error
  // state; the service owns the request.
  const fetchData = useCallback(async () => {
    setLoading(true)
    setError(null)
    try {
      setItems(await list[[ View ]]())
    } catch (err) {
      setError(err.message)
    } finally {
      setLoading(false)
    }
  }, [])

  useEffect(() => {
    fetchData()
  }, [fetchData])

  return (
    <LayoutAuthenticated>
      <SectionMain>
        <SectionTitleLineWithButton icon={mdiViewDashboardOutline} title="[[ view_title ]]" main>
          <button
            type="button"
            className="rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"
            onClick={fetchData}
          >
            Refresh
          </button>
        </SectionTitleLineWithButton>

        <CardBox className="mb-6">
          {loading ? (
            <p className="text-sm text-slate-500">Loading…</p>
          ) : error ? (
            <p className="text-sm text-red-600">{error}</p>
          ) : items.length === 0 ? (
            <p className="py-8 text-center text-sm text-slate-500">Nothing here yet.</p>
          ) : (
            <ul className="divide-y divide-slate-200 dark:divide-slate-700">
              {items.map((item) => (
                <li key={item.id} className="py-3">
                  <span className="font-medium">{item.name}</span>
                  {item.description ? (
                    <span className="ml-2 text-sm text-slate-500">{item.description}</span>
                  ) : null}
                </li>
              ))}
            </ul>
          )}
        </CardBox>
      </SectionMain>
    </LayoutAuthenticated>
  )
}
