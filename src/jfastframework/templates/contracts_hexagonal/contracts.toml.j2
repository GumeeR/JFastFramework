# Contracts for {{ Project }}.
#
# Declared by you. Enforced by `jfast contracts check`. Read by agents through
# `jfast contracts show --json`.
#
# The defaults below are a floor. The lines worth writing are the ones only you
# know: what this service does NOT own, which interfaces are promises, and the
# invariants a checker cannot see.

[project]
name = "{{ project }}"
language = "python"
owns = "TODO: one sentence. If it takes two, the service is doing two jobs."
does_not_own = "TODO: name the neighbouring concerns and who owns them."

# ---------------------------------------------------------------------------
# Layers. Ports and adapters, so the dependencies point inward to the domain
# and never back out.
#
# The rule that makes this layout worth its cost is the one on `domain`: it may
# import nothing. Not the ORM, not FastAPI, not the application layer. The
# moment the domain imports SQLAlchemy the layout has stopped paying for
# itself, because the thing you were buying -- a domain testable in
# milliseconds with no database -- is gone.
# ---------------------------------------------------------------------------

[layers.domain]
description = "Entities, value objects and the ports. Depends on nothing."
paths = ["modules/*/domain/*.py"]
may_import = []
# The whole point of the layout, stated as a rule so it is checked rather than
# remembered.
forbid_packages = ["sqlalchemy", "fastapi", "starlette", "httpx", "redis"]

[layers.application]
description = "Use cases. Orchestrates the domain through ports, nothing else."
paths = ["modules/*/application/*.py"]
may_import = ["domain"]
# An application layer that imports the concrete repository has bypassed the
# port, and the use case is no longer testable without a database.
forbid_packages = ["sqlalchemy", "fastapi", "starlette"]

[layers.infrastructure]
description = "The adapters that implement the ports: ORM, clients, caches."
paths = ["modules/*/infrastructure/*.py"]
may_import = ["domain"]
forbid_packages = ["fastapi", "starlette"]

[layers.adapters]
description = "Driving adapters. HTTP in, response out, and wiring."
paths = ["modules/*/adapters/*.py"]
may_import = ["domain", "application", "infrastructure"]

# ---------------------------------------------------------------------------
# Rules
# ---------------------------------------------------------------------------

[[rules.forbid_call]]
pattern = "os.getenv"
except_in = ["settings.py", "config/*.py", "migrations/env.py"]
why = "Configuration is typed. Add a field to a settings model so a bad value fails at boot."

[[rules.forbid_call]]
pattern = "print"
why = "Use the structured logger; print output has no request id and no level."

[[rules.require]]
path = "tests"
applies_to = "modules/*"
why = "A module with no tests is a module nobody can change safely."

[[rules.require]]
path = "README.md"
applies_to = "modules/*"
why = "One paragraph on what the module owns. If it takes two, split it."

# ---------------------------------------------------------------------------
# Interfaces
# ---------------------------------------------------------------------------

# [[provides]]
# name = "invoices-api"
# kind = "http"
# path = "/invoices"
# stability = "stable"    # experimental | stable | deprecated

# [[consumes]]
# name = "catalog"
