# via_env = "API_CATALOG_URL"

# ---------------------------------------------------------------------------
# Placement: where a shared thing lives.
#
# Two modules that import each other are one module with a folder between them.
# When a second module needs the same enum, type or pure function, it moves to
# shared/ -- and the check names the file. The direction is one-way: modules
# import shared/, shared/ imports no module.
# ---------------------------------------------------------------------------

[rules.placement]
enabled = true

[layers.shared]
paths = ["shared/*.py"]
may_import = []
forbid_packages = ["sqlalchemy", "fastapi"]
description = "Enums, types and pure functions more than one module needs."

# ---------------------------------------------------------------------------
# Event-loop safety.
#
# A blocking call inside `async def` does not raise and does not log. It stalls
# every other request on the worker for its duration, and the symptom shows up
# as latency on endpoints that have nothing to do with the cause.
# ---------------------------------------------------------------------------

[rules.async_safety]
enabled = true
allow_in = ["tests/*", "conftest.py", "scripts/*", "migrations/*"]
follow_local_helpers = true

[rules.async_safety.extra_blocking]
# "myapp.legacy.render_pdf" = "await asyncio.to_thread(render_pdf, ...)"

# ---------------------------------------------------------------------------
# Invariants the checker cannot verify.
# ---------------------------------------------------------------------------

[invariants]
rules = [
  "A port is defined in the domain and implemented in infrastructure. Never the reverse.",
  "The domain test suite runs with no database and no network.",
  "Money is stored in minor units as an integer. Never a float.",
  "TODO: replace these with the rules that actually matter here.",
]
