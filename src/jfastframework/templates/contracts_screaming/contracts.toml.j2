# ---------------------------------------------------------------------------
# Placement: where a shared thing lives.
#
# Two modules that import each other are one module with a folder between them.
# Neither can be extracted into a service later, and a change to one breaks the
# other in a way no test covers. So when a second module needs the same enum,
# type or pure function, it moves to shared/ -- and the check names the file.
#
# The direction is one-way: modules import shared/, shared/ imports no module.
# Without that, shared/ becomes where everything ends up and the graph is a
# circle.
# ---------------------------------------------------------------------------

[rules.placement]
enabled = true

[layers.shared]
paths = ["shared/*.py"]
# Empty, and it is the entry that makes every other one safe. Each layer above
# may import shared/; the moment shared/ could import one of them back, the
# graph is a circle and shared/ becomes where everything ends up.
may_import = []
# Nothing here touches a database. Two modules sharing a repository is two
# modules sharing a table, which is how services become a distributed monolith.
forbid_packages = ["sqlalchemy", "fastapi"]
description = "Enums, types and pure functions more than one module needs."

# ---------------------------------------------------------------------------
# Event-loop safety.
#
# A blocking call inside `async def` does not raise and does not log. It stalls
# every other request on the worker for its duration, and the symptom shows up
# as latency on endpoints that have nothing to do with the cause. `jfast
# contracts check` reports them; ruff's ASYNC rules cover the standard library
# if you also run ruff.
#
# Waive one inline when blocking is genuinely correct:
#     time.sleep(0)  # contracts: allow one-off, at startup, not per request
# ---------------------------------------------------------------------------

[rules.async_safety]
enabled = true
# Two rules share this table. `naive-datetime` is not about the event loop at
# all -- it rejects a datetime built with no time zone, whose meaning is
# whatever zone the process happens to run in. It gets its own switch so that
# silencing it does not silence the async check with it.
naive_datetime = true
# Paths not worth checking. Replaces the default rather than adding to it, so
# what is listed here is the whole list.
allow_in = ["tests/*", "conftest.py", "scripts/*", "migrations/*"]
# Follow a synchronous helper defined in the same file into its async callers.
follow_local_helpers = true

# Calls in YOUR code that block, and what to reach for instead. The checker
# knows about boto3, pymongo, psycopg2, sync redis and sqlite3 already.
[rules.async_safety.extra_blocking]
# "myapp.legacy.render_pdf" = "await asyncio.to_thread(render_pdf, ...)"

# ---------------------------------------------------------------------------
# Invariants the checker cannot verify.
# ---------------------------------------------------------------------------

[invariants]
rules = [
  "A rule about one object's own state lives in the entity; a rule needing the repository lives in a use case.",
  "A new capability is a new file in use_cases/, not another method on an existing class.",
  "Money is stored in minor units as an integer. Never a float.",
  "TODO: replace these with the rules that actually matter here.",
]
